# ==========================================
# Compete Academy — Environment Configuration
# ==========================================
# Copy this file to .env.local and provide strong cryptographic values.
# NEVER commit .env or .env.local to version control.

# 1. Admin Authentication & Session Security (Required: minimum 32 bytes random secret)
ADMIN_JWT_SECRET=replace_with_64_char_cryptographic_random_secret

# Initial Administrator Provisioning (Used only on initial bootstrap / rotation)
ADMIN_INITIAL_EMAIL=admin@competeacademy.in
ADMIN_INITIAL_PASSWORD=replace_with_strong_initial_admin_password

# 2. Resource Download Verification & Authorization
DOWNLOAD_JWT_SECRET=replace_with_64_char_download_jwt_secret
OTP_HASH_SALT=replace_with_32_char_otp_hash_salt

# 3. SMTP Email Configuration (For Admin Password Recovery Links)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=no-reply@competeacademy.in
# SMTP_PASS=replace_with_smtp_password
# SMTP_FROM="Compete Academy Security <no-reply@competeacademy.in>"

# 4. SMS Gateway Provider Configuration
# Choose one of: msg91 | 2factor | twilio | fast2sms
SMS_PROVIDER=msg91
